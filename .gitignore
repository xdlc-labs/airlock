# Local Airlock state (app repos + testdata)
.airlock/
# ...except the toy agent's committed policy. The default gates that `init`
# writes (0.99 / 0.995) cannot resolve at a 3-case sample budget, so without a
# tuned policy the README quick start ends at INCONCLUSIVE on a fresh clone.
# `init` leaves an existing policy alone, so this one survives.
!testdata/toy-agent/.airlock/
testdata/toy-agent/.airlock/*
!testdata/toy-agent/.airlock/policy.yml

# Built CLI (repo-root binary from `go build -o airlock ./cmd/airlock`)
/airlock
/airlock-*
*.exe

# Go
*.test
*.out
coverage.out
coverage.*
*.coverprofile
profile.cov
vendor/
go.work
go.work.sum

# Release / packaging
dist/
bin/
*.tar.gz
*.zip
sha256sums.txt
checksums.txt

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editors / IDEs (keep testdata/.cursor/rules committed — do not ignore .cursor/)
.idea/
.vscode/
*.swp
*.swo
.fleet/
*~
